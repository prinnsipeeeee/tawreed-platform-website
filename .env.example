# Copy to .env. SQLite/local files are the defaults for local installation.
APP_URL=http://localhost:3000
DB_PROVIDER=sqlite
DATABASE_URL=file:./data/tawreed.db
STORAGE_DRIVER=local
UPLOAD_DIR=./data/uploads
# Required only when running the admin-account seeder (12+ character password).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# For Vercel: DB_PROVIDER=mysql and DATABASE_URL=mysql://user:password@host:3306/tawreed
# Add ?ssl=true to require TLS with certificate verification for hosted MySQL.
# For Vercel: STORAGE_DRIVER=blob; create a private Blob store and set its token.
BLOB_READ_WRITE_TOKEN=

