{
  "name": "tawreed-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run db:generate && next dev",
    "build": "npm run db:generate && next build --webpack",
    "start": "next start",
    "lint": "oxlint src scripts tests",
    "typecheck": "tsc --noEmit",
    "db:generate": "tsx scripts/database.ts generate",
    "db:migrate": "tsx scripts/database.ts migrate",
    "seed:landing-page-seeder-default": "tsx scripts/landing-page-seeder-default.ts",
    "seed:admin-account": "tsx scripts/admin-account-seeder.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx scripts/test-integration.ts",
    "test:browser": "playwright test",
    "test:mysql": "tsx scripts/test-mysql.ts"
  },
  "dependencies": {
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "@prisma/client": "^7.0.0",
    "@prisma/adapter-better-sqlite3": "^7.0.0",
    "@prisma/adapter-mariadb": "^7.0.0",
    "@vercel/blob": "^2.0.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.0.0",
    "exceljs": "^4.4.0",
    "zod": "^4.0.0",
    "server-only": "^0.0.1",
    "lucide-react": "^1.47.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@tailwindcss/postcss": "^4.3.3",
    "prisma": "^7.0.0",
    "tsx": "^4.20.0",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.8",
    "@playwright/test": "^1.56.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "mariadb": "^3.5.4",
    "mysql2": "^3.24.5",
    "deepmerge-ts": "^8.0.2",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
